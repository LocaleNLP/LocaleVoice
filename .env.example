# LocaleVoice environment configuration (Milestone 1).
# Copy to .env and fill in a real key. Never commit .env.
# Model identifiers are configurable; confirm exact values against
# current Meta documentation before making quality claims.

# API key for the Meta Model API and Meta ASR endpoint.
MODEL_API_KEY=replace_with_your_key

# Chat model identifier for https://api.meta.ai/v1 (OpenAI SDK base URL).
META_CHAT_MODEL=muse-spark-1.3

# ASR model identifier for POST https://api.meta.ai/v1/asr/transcribe.
META_ASR_MODEL=muse-voice-transcribe-1.0

# Optional Arabic language bias for transcription (a hint only;
# NOT a guarantee of Moroccan Darija recognition). Example: ar
# LOCALEVOICE_ASR_LANGUAGE_BIAS=
